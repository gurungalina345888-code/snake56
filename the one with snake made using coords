def updpoints():
    global score, foodstep
    fo.clear()
    fo.hideturtle()
    fo.penup()
    fo.goto(350, 350)
    fo.write(f"points: {score}",  align="right", font=("Arial", 20, "bold"))
    fo.goto(350, 300)
    fo.write(f"food moving in {foodstep}steps", align="right", font=("Arial", 20, "bold"))

direction = "right"
def up():
    global direction
    if direction != "down":
        direction = "up"
def down():
    global direction
    if direction != "up":
        direction = "down"
def left():
    global direction
    if direction != "right":
        direction = "left"
def right():
    global direction
    if direction != "left":
        direction = "right"
def collision():
    global x, y
    global is_collision, head
    if x <= -399 or x >= 380 or y <= -400 or y >= 400:
        is_collision = True
        head.goto(0, 0)
        go.goto(0, 0)
        go.write("game over. press space to restart.", align="center", font=("arial", 20, "bold"))
    s.hideturtle()
    s.penup()
    f.penup()
def res():
    global x, y
    global is_collision
    if is_collision == True:
        is_collision = False   
        go.reset()
        go.hideturtle()
        x = 0
        y = 0
fx = 0
fy = 0
def food():
    global fx, fy
    f.penup()
    fx = random.randint(-400, 400)
    fy = random.randint(-350, 350)
    f.shape("circle")
    f.color("red")
    f.goto(fx ,fy)
    f.showturtle() 

def eat():
    global score
    global x, y, fx, fy, headwidth
    if 0 <= abs(x - fx) <= 15 and 0 <= abs(y - fy) <= 15:
        score+=10
        food()
        
        headwidth+=10
        hea()
        
        # add_segment()
def gameloop():
    global x, y
    global is_collision, foodstep
    if is_collision == False:
        collision()
        if direction == "up":
            y+=20
        elif direction == "down":
            y-=20
        elif direction == "left":
            x-=20
        elif direction == "right":
            x+=20
        if foodstep <= 0:
            food()
            foodstep = 100
        foodstep -= 1
        updpoints()
        hea()
        eat()
    t.update()
    screen.ontimer(gameloop, 200)
food()




